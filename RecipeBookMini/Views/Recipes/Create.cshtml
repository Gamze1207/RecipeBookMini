@using RecipeBookMini.Data.Entities
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Create Recipe";
}
<h2 class="mb-4">Create a New Recipe</h2>

<form method="post" action="Create">
    <div class="form-group">
        <label for="recipe_name">Recipe Name</label>
        <input type="text" class="form-control" name="name" id="recipe_name" placeholder="Enter recipe name here">
    </div>

    <div class="form-group">
        <label for="recipe_category">Category</label>
        <select class="form-control" name="categoryId" id="recipe_category">
            <option value="">-- Select Category --</option>
            @foreach (var cat in (List<Category>)ViewBag.Categories)
            {
                <option value="@cat.CategoryId">@cat.Name</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label for="recipe_products">Products / Ingredients</label>
        <textarea class="form-control" name="products" id="recipe_products" rows="3" placeholder="Enter products here"></textarea>
    </div>

    <div class="form-group">
        <label for="recipe_method">Preparation Method</label>
        <textarea class="form-control" name="preparationMethod" id="recipe_method" rows="4" placeholder="Enter preparation method here"></textarea>
    </div>

    <div class="form-group">
        <label for="recipe_time">Preparation Time (in minutes)</label>
        <input type="number" class="form-control" name="preparationTimeMinutes" id="recipe_time" min="1" placeholder="Enter time in minutes">
        <small class="form-text text-muted">Preparation time must be a positive number</small>
    </div>

    <button type="submit" class="btn btn-primary my-3">Save</button>
</form>
