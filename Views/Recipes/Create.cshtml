<form method="post" action="recipes/create">
    <div class="form-group">
        <label for="recipe_title">Recipe Title</label>
        <input type="text" class="form-control" name="title" id="recipe_title" placeholder="Enter the recipe name here">
        <small class="form-text text-muted">Enter the title using standard characters</small>
    </div>

    <div class="form-group">
        <label for="recipe_category">Recipe Category</label>
        <select class="form-control" name="category" id="recipe_category">
            <option value="" selected disabled>Select a category</option>
            <option value="appetizer">Appetizer / Starter</option>
            <option value="main-course">Main Course</option>
            <option value="dessert">Dessert</option>
            <option value="side-dish">Side Dish</option>
            <option value="soup">Soup / Stew</option>
            <option value="beverage">Beverage / Drink</option>
            <option value="breakfast">Breakfast / Brunch</option>
        </select>
    </div>

    <div class="form-group">
        <label for="recipe_author">Recipe Author / Chef</label>
        <input type="text" class="form-control" name="author" id="recipe_author" placeholder="Enter the author's name">
    </div>

    <button type="submit" class="btn btn-primary my-3">Save Recipe</button>
</form>